<ui:FluentWindow x:Class="MeshGenLite.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vtk="clr-namespace:Kitware.VTK;assembly=Kitware.VTK"
                 xmlns:viewModels="clr-namespace:MeshGenLite.ViewModels"
                 xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
                 mc:Ignorable="d"
                 Title="MeshGen Lite"
                 Height="1040"
                 Width="1560"
                 MinHeight="780"
                 MinWidth="1280"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{StaticResource BrandTextFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="MeshGen Lite"
                     Icon="pack://application:,,,/">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="CubeTree24" FontSize="18" Foreground="{StaticResource BrandAccentBrush}" />
                    <TextBlock Text="MeshGen Lite"
                               Margin="10,0,0,0"
                               FontFamily="{StaticResource BrandDisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Margin="12,0,0,0"
                            Padding="8,2"
                            Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                            CornerRadius="10"
                            VerticalAlignment="Center">
                        <TextBlock Text="MVP · Mesh Pipeline"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="10,4,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="360" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0"
                     Padding="0"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Stretch">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="20,20,20,14">
                        <TextBlock Text="Pipeline"
                                   FontFamily="{StaticResource BrandDisplayFont}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Seven-step mesh generation"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="14,0,14,18">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:PipelineStepViewModel}">
                                    <Border Margin="0,0,0,8"
                                            Padding="12,10"
                                            CornerRadius="10"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{Binding StatusBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="30"
                                                    Height="30"
                                                    CornerRadius="15"
                                                    Background="{Binding StatusBrush}"
                                                    Opacity="0.18"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       Foreground="{Binding StatusBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Width="30"
                                                       TextAlignment="Center" />

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Caption}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13" />
                                                <TextBlock Text="{Binding StatusGlyph}"
                                                           FontSize="11"
                                                           Foreground="{Binding StatusBrush}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </ui:Card>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True" />

            <ui:Card Grid.Column="2"
                     Padding="2"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Stretch">
                <Grid ClipToBounds="True"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <wfi:WindowsFormsHost x:Name="ViewportHost"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                        <vtk:RenderWindowControl x:Name="RenderControl" Dock="Fill" />
                    </wfi:WindowsFormsHost>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10"
                            Padding="12,8"
                            CornerRadius="12"
                            Background="#CC181A1D"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Eye24" FontSize="14" Foreground="{StaticResource BrandAccentBrush}" />
                                <TextBlock Text="Viewport HUD"
                                           Margin="6,0,0,0"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusBar.HudText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       MaxWidth="360" />
                        </StackPanel>
                    </Border>

                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="10"
                                Orientation="Horizontal">
                        <ui:Button Command="{Binding ToggleViewportPickCommand}"
                                   Content="{Binding ElectrodePanel.PlacementButtonText}"
                                   Icon="{ui:SymbolIcon TargetArrow24}"
                                   Appearance="Secondary"
                                   Margin="0,0,8,0" />
                        <ui:Button Command="{Binding ResetCameraCommand}"
                                   Content="Reset Camera"
                                   Icon="{ui:SymbolIcon FullScreenMaximize24}"
                                   Appearance="Secondary" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True" />

            <ui:Card Grid.Column="4"
                     Padding="0"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel>
                        <Border CornerRadius="10"
                                Padding="16"
                                Margin="0,0,0,14"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="18" Foreground="{StaticResource BrandAccentBrush}" />
                                    <TextBlock Text="Step 1 · Import"
                                               Style="{StaticResource SectionHeaderTextStyle}"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Use either a DICOM series folder or a NIfTI label map file (.nii / .nii.gz)."
                                           Style="{StaticResource SectionCaptionTextStyle}" />

                                <TextBlock Text="Volume Source" Style="{StaticResource FieldLabelTextStyle}" />
                                <ui:TextBox Text="{Binding Import.CtSeriesPath, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="DICOM folder or NIfTI file path"
                                            Icon="{ui:SymbolIcon DocumentFolder24}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <ui:Button Command="{Binding BrowseCtSeriesCommand}"
                                               Content="Browse DICOM"
                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                               Appearance="Secondary"
                                               Margin="0,0,6,6" />
                                    <ui:Button Command="{Binding BrowseVolumeFileCommand}"
                                               Content="Browse NIfTI"
                                               Icon="{ui:SymbolIcon Document24}"
                                               Appearance="Secondary"
                                               Margin="0,0,6,6" />
                                </WrapPanel>

                                <TextBlock Text="NIfTI Selection" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBlock Text="{Binding Import.NiftiSelectionSummary}"
                                           Style="{StaticResource MutedTextStyle}" />

                                <TextBlock Text="RT Structure Set (optional for NIfTI)" Style="{StaticResource FieldLabelTextStyle}" />
                                <ui:TextBox Text="{Binding Import.RtssPath, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Optional .dcm path"
                                            Icon="{ui:SymbolIcon DocumentBulletList24}" />
                                <ui:Button Command="{Binding BrowseRtssCommand}"
                                           Content="Browse RTSS"
                                           Icon="{ui:SymbolIcon Document24}"
                                           Appearance="Secondary"
                                           Margin="0,8,0,0" />

                                <TextBlock Text="Target Spacing (mm)" Style="{StaticResource FieldLabelTextStyle}" />
                                <ui:TextBox Text="{Binding Import.TargetSpacing, UpdateSourceTrigger=PropertyChanged}"
                                            Width="140"
                                            HorizontalAlignment="Left"
                                            PlaceholderText="2.0" />

                                <Rectangle Height="1" Margin="0,14,0,10" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                                <WrapPanel>
                                    <ui:Button Command="{Binding ImportCommand}"
                                               Content="Import Study"
                                               Icon="{ui:SymbolIcon ArrowDownload24}"
                                               Appearance="Primary"
                                               Margin="0,0,6,6" />
                                    <ui:Button Command="{Binding BuildLabelMapCommand}"
                                               Content="Build Label Map"
                                               Icon="{ui:SymbolIcon Layer24}"
                                               Appearance="Secondary"
                                               Margin="0,0,6,6" />
                                    <ui:Button Command="{Binding BuildSurfaceCommand}"
                                               Content="Build Surface"
                                               Icon="{ui:SymbolIcon Shapes24}"
                                               Appearance="Secondary"
                                               Margin="0,0,6,6" />
                                </WrapPanel>

                                <TextBlock Text="{Binding Import.Summary}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="10"
                                Padding="16"
                                Margin="0,0,0,14"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Organization24" FontSize="18" Foreground="{StaticResource BrandAccentBrush}" />
                                        <TextBlock Text="Step 2-3 · ROI Control"
                                                   Style="{StaticResource SectionHeaderTextStyle}"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Select external ROI and toggle individual surfaces."
                                           Style="{StaticResource SectionCaptionTextStyle}" />

                                <TextBlock Text="External ROI" Style="{StaticResource FieldLabelTextStyle}" />
                                <ComboBox ItemsSource="{Binding RoiPanel.ExternalCandidates}"
                                          SelectedItem="{Binding RoiPanel.SelectedExternalRoi}"
                                          DisplayMemberPath="Name" />

                                <TextBlock Text="External Smoothing Iterations" Style="{StaticResource FieldLabelTextStyle}" />
                                <ui:TextBox Text="{Binding RoiPanel.ExternalSmoothingIterations, UpdateSourceTrigger=PropertyChanged}"
                                            Width="140"
                                            HorizontalAlignment="Left"
                                            PlaceholderText="20" />

                                <ListBox ItemsSource="{Binding RoiPanel.Rois}"
                                         Margin="0,14,0,0"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                                        <Ellipse Width="12"
                                                                 Height="12"
                                                                 Fill="{Binding ColorBrush}"
                                                                 Margin="10,0,8,0"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Id, StringFormat='  #\{0\}'}"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding ColorHex}"
                                                               Margin="22,6,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Grid Margin="22,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:ToggleSwitch Grid.Column="0"
                                                                         IsChecked="{Binding Visibility}"
                                                                         Content="Visible" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="Opacity"
                                                                   Margin="14,0,10,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Slider Grid.Column="2"
                                                                Minimum="0.05"
                                                                Maximum="1.0"
                                                                Value="{Binding Opacity}"
                                                                VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <Border CornerRadius="10"
                                Padding="16"
                                Margin="0,0,0,14"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CircleSmall24" FontSize="18" Foreground="{StaticResource BrandAccentBrush}" />
                                    <TextBlock Text="Step 4-5 · Electrode Placement"
                                               Style="{StaticResource SectionHeaderTextStyle}"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Specify geometry, enter placement mode, then click on the external surface."
                                           Style="{StaticResource SectionCaptionTextStyle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Radius (mm)" Style="{StaticResource FieldLabelTextStyle}" />
                                        <ui:TextBox Text="{Binding ElectrodePanel.Spec.Radius, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Height (mm)" Style="{StaticResource FieldLabelTextStyle}" />
                                        <ui:TextBox Text="{Binding ElectrodePanel.Spec.Height, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Color" Style="{StaticResource FieldLabelTextStyle}" />
                                        <ui:TextBox Text="{Binding ElectrodePanel.ColorHex, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,10,0,0">
                                    <ui:Button Command="{Binding ToggleViewportPickCommand}"
                                               Content="{Binding ElectrodePanel.PlacementButtonText}"
                                               Icon="{ui:SymbolIcon TargetArrow24}"
                                               Appearance="Primary"
                                               Margin="0,0,6,6" />
                                    <ui:Button Command="{Binding RemovePlacementCommand}"
                                               Content="Remove Selected"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               Appearance="Caution"
                                               Margin="0,0,6,6" />
                                </WrapPanel>

                                <TextBlock Text="{Binding ElectrodePanel.PlacementStatusText}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,8,0,0" />

                                <ListBox ItemsSource="{Binding ElectrodePanel.Placements}"
                                         SelectedItem="{Binding ElectrodePanel.SelectedPlacement}"
                                         Margin="0,10,0,0"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Id, StringFormat=Electrode #\{0\}}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SurfaceSummary, StringFormat=Surface: \{0\}}"
                                                               FontSize="11"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding WorldSummary, StringFormat=World: \{0\}}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding NormalSummary, StringFormat=Normal: \{0\}}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding CellSummary}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{Binding GeometrySummary}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="10"
                                Padding="16"
                                Margin="0,0,0,14"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ScanCamera24" FontSize="18" Foreground="{StaticResource BrandAccentBrush}" />
                                    <TextBlock Text="Step 6 · Attachment"
                                               Style="{StaticResource SectionHeaderTextStyle}"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Run sequential elastic attachment for all placed electrodes, then inspect patch and body toggles."
                                           Style="{StaticResource SectionCaptionTextStyle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Contact Threshold (mm)" Style="{StaticResource FieldLabelTextStyle}" />
                                        <ui:TextBox Text="{Binding DeformationConfig.ContactDistanceThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Expansion Rings" Style="{StaticResource FieldLabelTextStyle}" />
                                        <ui:TextBox Text="{Binding DeformationConfig.ContactExpansionRing, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Smooth Iterations" Style="{StaticResource FieldLabelTextStyle}" />
                                        <ui:TextBox Text="{Binding DeformationConfig.SmoothingIterations, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Hard Weight" Style="{StaticResource FieldLabelTextStyle}" />
                                        <ui:TextBox Text="{Binding DeformationConfig.HardConstraintWeight, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Soft Weight" Style="{StaticResource FieldLabelTextStyle}" />
                                        <ui:TextBox Text="{Binding DeformationConfig.SoftConstraintWeight, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,12,0,0">
                                    <ui:Button Command="{Binding AttachElectrodesCommand}"
                                               Content="Attach All Electrodes"
                                               Icon="{ui:SymbolIcon Play24}"
                                               Appearance="Primary"
                                               Margin="0,0,6,6" />
                                    <ui:Button Command="{Binding ToggleContactPatchCommand}"
                                               Content="{Binding Attachment.ContactPatchButtonText}"
                                               Icon="{ui:SymbolIcon Highlight24}"
                                               Appearance="Secondary"
                                               Margin="0,0,6,6" />
                                    <ui:Button Command="{Binding ToggleBodyViewCommand}"
                                               Content="{Binding Attachment.BodyViewButtonText}"
                                               Icon="{ui:SymbolIcon ArrowSwap24}"
                                               Appearance="Secondary"
                                               Margin="0,0,6,6" />
                                </WrapPanel>

                                <Border Margin="0,10,0,0"
                                        Padding="8,2"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Attachment.StatusText}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>

                                <TextBlock Text="{Binding Attachment.Summary}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Attachment.QualitySummary}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="10"
                                Padding="16"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CubeMultiple24" FontSize="18" Foreground="{StaticResource BrandAccentBrush}" />
                                    <TextBlock Text="Step 7 · Volume Mesh &amp; Export"
                                               Style="{StaticResource SectionHeaderTextStyle}"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Generate a tetrahedral mesh (Delaunay3D) from the final surface, or export the surface to STL / POLY."
                                           Style="{StaticResource SectionCaptionTextStyle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Alpha (mm · 0 = hull)" Style="{StaticResource FieldLabelTextStyle}" />
                                        <ui:TextBox Text="{Binding VolumeMesh.AlphaMm, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Max Points (0 = no decimation)" Style="{StaticResource FieldLabelTextStyle}" />
                                        <ui:TextBox Text="{Binding VolumeMesh.MaxPoints, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="5000" />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,12,0,0">
                                    <ui:Button Command="{Binding GenerateVolumeMeshCommand}"
                                               Content="Generate Volume Mesh"
                                               Icon="{ui:SymbolIcon CubeTree24}"
                                               Appearance="Primary"
                                               Margin="0,0,6,6" />
                                    <ui:Button Command="{Binding ExportStlCommand}"
                                               Content="Export STL"
                                               Icon="{ui:SymbolIcon Save24}"
                                               Appearance="Secondary"
                                               Margin="0,0,6,6" />
                                    <ui:Button Command="{Binding ExportPolyCommand}"
                                               Content="Export POLY"
                                               Icon="{ui:SymbolIcon Save24}"
                                               Appearance="Secondary"
                                               Margin="0,0,6,6" />
                                </WrapPanel>

                                <TextBlock Text="{Binding VolumeMesh.Summary}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>
        </Grid>

        <ui:Card Grid.Row="2" Margin="10,6,10,8" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:ProgressRing Grid.Column="0"
                                 IsIndeterminate="{Binding StatusBar.IsBusy}"
                                 Visibility="{Binding StatusBar.IsBusy, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}"
                                 Width="22"
                                 Height="22"
                                 Margin="0,0,14,0"
                                 VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusBar.Message}"
                               FontWeight="SemiBold"
                               FontSize="13" />
                    <TextBlock Text="{Binding StatusBar.Detail}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <ui:Button Grid.Column="2"
                           Command="{Binding CancelCommand}"
                           Content="Cancel"
                           Icon="{ui:SymbolIcon DismissCircle24}"
                           Appearance="Danger"
                           VerticalAlignment="Center" />
            </Grid>
        </ui:Card>
    </Grid>
</ui:FluentWindow>
